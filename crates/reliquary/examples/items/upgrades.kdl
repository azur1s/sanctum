// Upgrade items. An item with an `upgrade "<id>"` line applies that upgrade from
// configs/upgrades.kdl. Hold it in your offhand and the item in your main hand, then
// `/relic upgrade` uses one.
// It does nothing else, so it can't have stats, skills or sockets of its own.

item "polish" {
    name "Polish"
    kind "Consumable"
    base "minecraft:iron_ingot"
    rarity "rare"
    lore "Brings out the shine, and then some."
    upgrade "polish"
}

// A growing upgrade: used once, then it levels up from kills.
item "bloodlust" {
    name "Bloodlust"
    kind "Consumable"
    base "minecraft:redstone"
    rarity "epic"
    lore "It remembers every one of them."
    upgrade "bloodlust"
}
