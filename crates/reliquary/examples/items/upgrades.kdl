// Upgrade items. An item with an `upgrade "<id>"` line applies that upgrade from
// upgrades.kdl. Hold it in your offhand and the item in your main hand, then
// `/relic upgrade` uses one.
// It does nothing else, so it can't have stats, skills or sockets of its own.

item "polish" {
    name "Polish"
    kind "Consumable"
    base "minecraft:iron_ingot"
    rarity "rare"
    lore "Brings out the shine, and then some."
    upgrade "polish"
}
