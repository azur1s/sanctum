// How stats look in item lore. Stats show in the order listed here; any
// stat not listed comes after them, by name, with the default `format`.
//
// format  The line. {name} is the stat's name, {value} its amount and
//         {sign} a "+" for amounts of 0 or more (negative ones already
//         have their "-"). {fill} is a row of dim dots that pushes what comes
//         after it to the tooltip's right edge; give what follows its own
//         color, or it stays dim. {color:&a} is the element's color on a
//         stat tagged with one (`damage 2 element="fire"`), and &a otherwise.
//         The top-level one is the default for every stat.
// name    The stat's name in the lore. Defaults to the stat in title case,
//         like "Magic Power".
// hidden  #true leaves the stat out of the lore. It still counts.
//
// Stats tagged with an element, like `damage 2 element="fire"`, look like their
// stat with the element's name in front ("Fire Damage"). Give one its own look
// with `stat "damage" element="fire" { ... }`.
//
// Icons are ordinary text. These are drawn by Minecraft's normal font, so the
// dots line up exactly: ❤ ♥ ⚔ ☠ ☄ ⚡ 🛡 ★ ☆ ◆ ◇ ♦ ♠ ♣ ● ○ ■ □ ▲ ▼ ▶ ◀ ☽ ☀ ☁ ☂
// ☃ ♪ ♫ ✎ ⚑ ∞ ✔. Others may be a pixel or two off (like ✦ ✖ ☘ ❈ ➜).

format "{color:&7}• &7{name}{fill}&b{sign}{value}"

// Damage and attack speed are the item's totals, not bonuses: no sign.
stat "damage" {
    name "Damage"
    format "{color:&c}⚔ &7{name}{fill}&c{value}"
}

stat "attack-speed" {
    name "Attack Speed"
    format "&e⚡ &7{name}{fill}&e{value}"
}

stat "health" {
    name "Health"
    format "&c❤ &7{name}{fill}&c{sign}{value}"
}

stat "defense" {
    name "Defense"
    format "{color:&a}🛡 &7{name}{fill}&a{sign}{value}"
}

stat "armor-toughness" {
    name "Armor Toughness"
    format "&a♦ &7{name}{fill}&a{sign}{value}"
}

// Percent: `speed 10` is 10% faster.
stat "speed" {
    name "Speed"
    format "&f▶ &7{name}{fill}&f{sign}{value}%"
}

stat "strength" {
    name "Strength"
    format "{color:&c}☠ &7{name}{fill}&c{sign}{value}"
}

// Percents: `crit-chance 25` crits one hit in four, and a crit deals
// 1 + crit-power / 100 times the damage. Players start with 50 crit power (1.5x).
stat "crit-chance" {
    name "Crit Chance"
    format "&6◇ &7{name}{fill}&6{sign}{value}%"
}

stat "crit-power" {
    name "Crit Power"
    format "&6◆ &7{name}{fill}&6{sign}{value}%"
}

stat "magic-power" {
    name "Magic Power"
    format "{color:&d}★ &7{name}{fill}&d{sign}{value}"
}

stat "magic-defense" {
    name "Magic Defense"
    format "{color:&d}☆ &7{name}{fill}&d{sign}{value}"
}

stat "max-mana" {
    name "Max Mana"
    format "&b☽ &7{name}{fill}&b{sign}{value}"
}

stat "mana-regen" {
    name "Mana Regen"
    format "&b☄ &7{name}{fill}&b{sign}{value}"
}
