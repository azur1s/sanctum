// How stats look in item lore. Stats show in the order listed here; any
// stat not listed comes after them, by name, with the default `format`.
//
// format  The line. {name} is the stat's name, {value} its amount and
//         {sign} a "+" for amounts of 0 or more (negative ones already
//         have their "-"). {fill} is a row of dim dots that pushes what comes
//         after it to the tooltip's right edge; give what follows its own
//         color, or it stays dim. The top-level one is the default for every
//         stat.
// name    The stat's name in the lore. Defaults to the stat in title case,
//         like "Magic Power".
// hidden  #true leaves the stat out of the lore. It still counts.
//
// Icons are ordinary text. These are drawn by Minecraft's normal font, so the
// dots line up exactly: ❤ ♥ ⚔ ☠ ☄ ⚡ 🛡 ★ ☆ ◆ ◇ ♦ ♠ ♣ ● ○ ■ □ ▲ ▼ ▶ ◀ ☽ ☀ ☁ ☂
// ☃ ♪ ♫ ✎ ⚑ ∞ ✔. Others may be a pixel or two off (like ✦ ✖ ☘ ❈ ➜).

format "&7• {name}{fill}&b{sign}{value}"

// Damage and attack speed are the item's totals, not bonuses: no sign.
stat "damage" {
    name "Damage"
    format "&c⚔ &7{name}{fill}&c{value}"
}

stat "attack-speed" {
    name "Attack Speed"
    format "&e⚡ &7{name}{fill}&e{value}"
}

stat "health" {
    name "Health"
    format "&c❤ &7{name}{fill}&c{sign}{value}"
}

stat "armor" {
    name "Armor"
    format "&a🛡 &7{name}{fill}&a{sign}{value}"
}

stat "armor-toughness" {
    name "Armor Toughness"
    format "&a♦ &7{name}{fill}&a{sign}{value}"
}

// Percent: `speed 10` is 10% faster.
stat "speed" {
    name "Speed"
    format "&f▶ &7{name}{fill}&f{sign}{value}%"
}

stat "strength" {
    name "Strength"
    format "&c☠ &7{name}{fill}&c{sign}{value}"
}

stat "magic-power" {
    name "Magic Power"
    format "&d★ &7{name}{fill}&d{sign}{value}"
}

stat "magic-armor" {
    name "Magic Armor"
    format "&d☆ &7{name}{fill}&d{sign}{value}"
}

stat "max-mana" {
    name "Max Mana"
    format "&b☽ &7{name}{fill}&b{sign}{value}"
}

stat "mana-regen" {
    name "Mana Regen"
    format "&b☄ &7{name}{fill}&b{sign}{value}"
}
